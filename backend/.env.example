# ============================================================
#  Variables de entorno del backend
#  Copia este archivo como  .env  y completa los valores.
# ============================================================

# Puerto del servidor Express
PORT=4000

# URL del proyecto de Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# SERVICE ROLE KEY de Supabase (Settings -> API -> service_role).
# NUNCA se expone en el frontend: solo vive aquí, en el servidor.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Clave administrativa sencilla para proteger las operaciones del panel /admin.
# El frontend la enviará en la cabecera  x-admin-key.
ADMIN_KEY=cambia-esta-clave-secreta

# Origen permitido para CORS (URL del frontend). Usa * solo en pruebas locales.
CORS_ORIGIN=*
