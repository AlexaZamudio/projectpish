# ============================================================
#  Variables del frontend (Vite). Cópialo como  .env
# ============================================================

# URL base de la API. Déjalo vacío para usar el proxy de desarrollo
# (recomendado en local). En producción, pon la URL del backend, p.ej:
# VITE_API_URL=https://mi-backend.ejemplo.com
VITE_API_URL=

# Clave administrativa (la MISMA que ADMIN_KEY del backend).
# Se envía en la cabecera x-admin-key al abrir /admin.
# Nota: en un panel sin login, esta clave vive en el frontend; por eso
# el panel debe usarse en un entorno local/privado, o protegerse si se publica.
VITE_ADMIN_KEY=cambia-esta-clave-secreta
